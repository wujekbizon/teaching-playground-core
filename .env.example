# Server Configuration
PORT=3001
NODE_ENV=development

# WebSocket Configuration
# This URL should match your frontend origin
NEXT_PUBLIC_WS_URL=http://localhost:5173

# CORS Configuration
# Comma-separated list of allowed origins
# Use "*" to allow all origins (not recommended for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Development-only test identities for the classroom harness.
# Tokens use role:name, for example teacher:maya or student:alex.
# The server refuses to start with this enabled in production.
DEV_AUTH_ENABLED=false

# Optional: Logging
LOG_LEVEL=info

# Optional: Room Configuration
ROOM_CLEANUP_INTERVAL=300000
ROOM_INACTIVE_THRESHOLD=1800000
MESSAGE_HISTORY_LIMIT=100

# Optional: Rate Limiting
RATE_LIMIT_MESSAGES=5
RATE_LIMIT_WINDOW=10000
