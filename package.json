{
  "name": "@teaching-playground/core",
  "version": "2.7.0",
  "description": "A production-ready WebSocket and WebRTC virtual classroom system for real-time online education with video streaming, chat, and lecture management",
  "keywords": [
    "education",
    "virtual-classroom",
    "webrtc",
    "websocket",
    "socket.io",
    "video-streaming",
    "real-time",
    "teaching",
    "lecture",
    "classroom",
    "chat",
    "streaming"
  ],
  "author": "WESA",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./room-connection": {
      "types": "./dist/services/RoomConnection.d.ts",
      "import": "./dist/services/RoomConnection.js"
    },
    "./user": {
      "types": "./dist/interfaces/user.interface.d.ts",
      "import": "./dist/interfaces/user.interface.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wujekbizon/teaching-playground-core.git"
  },
  "bugs": {
    "url": "https://github.com/wujekbizon/teaching-playground-core/issues"
  },
  "homepage": "https://github.com/wujekbizon/teaching-playground-core#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src scripts --ext .ts",
    "server": "tsx src/server.ts",
    "server:dev": "tsx watch src/server.ts",
    "preharness:dev": "pnpm build",
    "harness:dev": "pnpm --dir examples/classroom-harness dev",
    "preharness:build": "pnpm build",
    "harness:build": "pnpm --dir examples/classroom-harness build",
    "harness:test": "pnpm --dir examples/classroom-harness test:e2e",
    "mixed:test": "pnpm --dir examples/classroom-harness test:mixed",
    "load:test": "tsx scripts/classroom-load-test.ts",
    "isolation:test": "tsx scripts/multi-room-isolation-test.ts",
    "test:package": "./scripts/test-package.sh",
    "test:integration": "./scripts/test-in-project.sh",
    "prepack": "npm run build",
    "pack:inspect": "npm pack --dry-run"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.2"
  }
}
